# ============================================================
#  文案搭子 · .gitignore（提交 GitHub 前必看）
#  关键：backend/.env 含你的真实 API Key，绝不可上传！
# ============================================================

# ---------- 密钥与环境变量（最高优先级） ----------
.env
backend/.env
*.env.local

# ---------- 运行时数据（含用户数据，不上传） ----------
backend/data/
*.db
*.sqlite3
*.db-journal

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------- 前端依赖与构建产物 ----------
frontend/node_modules/
# 注意：frontend/dist/ 不再忽略 —— 已提交到仓库，
# 这样下载者无需 Node / npm 即可运行（后端直接托管 dist）。
# 若你改了前端代码，请重新 `npm run build` 并更新 dist。
frontend/.vite/

# ---------- 系统 / 编辑器 ----------
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---------- 工作区记忆（不上传） ----------
.workbuddy/
